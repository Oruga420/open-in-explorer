{
  "manifest_version": 3,
  "name": "Open in Explorer",
  "version": "1.0.0",
  "description": "Click the toolbar button to open the folder whose path is in the current URL, with the file selected.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open this path in Explorer (Alt+Shift+E)",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "commands": {
    "open-in-explorer": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Open the path in the current URL in Explorer"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
